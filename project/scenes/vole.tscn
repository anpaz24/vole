[node name="Footer" type="Label" parent="InstructionsControl/Panel/VBoxContainer" unique_id=1844303547]
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "HEXADECIMAL
Each hexadecimal number is 4 bits.
It is written as a number from 0-9 or a letter from A-F.
An instruction is 4 hex numbers."
vertical_alignment = 1
