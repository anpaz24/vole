[node name="Header" type="Label" parent="InstructionsControl/Panel/VBoxContainer" unique_id=1519059839]
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "
BINARY
A bit is the base unit, it can be a 0 or a 1.
A nibble is 4 bits. 
A byte is 8 bits or 2 nibbles."
vertical_alignment = 1
justification_flags = 1

[node name="Spacer2" type="Control" parent="InstructionsControl/Panel/VBoxContainer" unique_id=1290612337]
layout_mode = 2
size_flags_vertical = 3

[node name="HSeparator2" type="HSeparator" parent="InstructionsControl/Panel/VBoxContainer" unique_id=940618537]
layout_mode = 2

[node name="Body" type="Label" parent="InstructionsControl/Panel/VBoxContainer" unique_id=1361787774]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "OpCode/
Operands  Instruction     Operation
1 RXY	     load  R,[XY]    register[R]:=memory[XY]
2 RXY     load  R,XY      register[R]:=XY
3 RXY     store R,[XY]    memory[XY]:=register[R]
D 0RS     load  R,[S]     reg[R]:=memory[reg[S]]
E 0RS     store R,[S]     memory[reg[S]]:=reg[R]
4 0RS     move  S,R       register[S]:=register[R]
5 RST     addi  R,S,T     reg[R]:=reg[S]+reg[T]
                            integer add
6 RST     addf  R,S,T     reg[R]:=reg[S]+reg[T]
                            floating-point add
7 RST     or    R,S,T     reg[R]:=reg[S] OR reg[T]
                            bitwise OR
8 RST     and   R,S,T     reg[R]:=reg[S] AND reg[T]
                            bitwise AND
9 RST     xor   R,S,T     reg[R]:=reg[S] XOR reg[T]
                            bitwise eXclusive OR
A R0X     ror   R,X       reg[R]:=reg[R] ROR X
                            ROtate Right R, X times
B RXY     jmpEQ R=R0,XY   PC:=XY, if R=R0
  0XY     jmp   XY        PC:=XY
F RXY     jmpLE R<=R0,XY  PC:=XY, if R<=R0
C 000	     halt            halt program"
vertical_alignment = 1
justification_flags = 1

[node name="HSeparator" type="HSeparator" parent="InstructionsControl/Panel/VBoxContainer" unique_id=1946179839]
layout_mode = 2

[node name="Spacer1" type="Control" parent="InstructionsControl/Panel/VBoxContainer" unique_id=242970047]
layout_mode = 2
size_flags_vertical = 3

[node name="Footer" type="Label" parent="InstructionsControl/Panel/VBoxContainer" unique_id=1844303547]
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "HEXADECIMAL
Each hexadecimal number is 4 bits.
It is written as a number from 0-9 or a letter from A-F.
An instruction is 4 hex numbers.
"
vertical_alignment = 1
justification_flags = 1
